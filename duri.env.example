# duri — server-only application secrets, consumed by the `duri` service via
# `env_file:` in compose.yaml. Copy to `duri.env` (gitignored) and fill in, or
# let `scripts/push-duri-env.sh` project it from duri's own `.env.hosted`.
#
# THIS FILE IS THE CONTRACT, not documentation. Two things read the key NAMES
# below and act on them:
#   - `scripts/push-duri-env.sh`  — pushes exactly these keys to the box
#   - `scripts/deploy-duri.sh`    — refuses to deploy if the box is missing one
# So adding a key here is how you add it to the deploy; a key that is not listed
# is not shipped and is not checked. Never put VALUES in this file.
#
# NOTE: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are deliberately
# absent — they are public, and baked into the image at BUILD time on the dev
# machine (deploy-duri.sh reads them straight from duri's `.env.hosted`). Putting
# them here would ship them twice and imply they are secret.
#
# Derived from duri's actual `process.env` reads, 2026-08-08. `BUILD_SHA`,
# `BUILD_TIME`, `NODE_ENV`, `PORT` are set by the image/runtime, not by this file.

# Supabase (Seoul) — server-only admin key. Bypasses RLS; treat as admin.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle (Supabase pooler, direct or :6543).
DATABASE_URL=

# LLM provider key for voice logging's parse seam (`docs/18`) and, later, broker
# import. **OpenAI, not Anthropic** — v1's `LLMProvider` impl was decided
# 2026-07-29; this file declared `ANTHROPIC_API_KEY` until 2026-08-08, which is a
# key duri reads nowhere. Without this, `/say` returns 503 and the preview card
# shows "voice logging is unavailable" while the numpad keeps working.
OPENAI_API_KEY=
