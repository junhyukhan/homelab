# Copy to torrent/gluetun.env (gitignored) and fill in, then: chmod 600 torrent/gluetun.env
#
#   cp torrent/gluetun.env.example torrent/gluetun.env
#
# THIS FILE IS A CONTRACT, NOT A DOC — the key names here are what gluetun reads.
# Same convention as duri.env.example (SPEC.md §Secrets).
#
# Get all three values from https://windscribe.com/getconfig/wireguard
# (log in → generate a WireGuard config). The generated config is an INI file;
# map it as follows:
#
#   [Interface]
#   PrivateKey = ...   →  WIREGUARD_PRIVATE_KEY
#   Address    = ...   →  WIREGUARD_ADDRESSES
#   [Peer]
#   PresharedKey = ... →  WIREGUARD_PRESHARED_KEY
#
# Do NOT paste the whole .conf file here, and do not commit it anywhere in this
# repo. Values move file-to-file; never echo/cat them to a console.

# Your 32-byte key in base64. Specific to you, and the same for every server.
WIREGUARD_PRIVATE_KEY=

# The tunnel interface address from the config, WITH the prefix length —
# e.g. 100.x.x.x/32. Also user-specific and the same for every server.
WIREGUARD_ADDRESSES=

# Windscribe REQUIRES this to be set (gluetun's Windscribe docs are explicit).
# It has a real value in the generated config — copy it.
WIREGUARD_PRESHARED_KEY=
