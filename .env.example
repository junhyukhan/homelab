# Copy to .env (gitignored) and fill in. See SPEC.md §Constraints for what
# consumes each key. The cloudflared tunnel does NOT use an env var — its
# credentials are a gitignored JSON file (see docs/tunnel-setup.md).

# Timezone for Home Assistant (and future services).
TZ=Asia/Seoul

# The box's stable Tailscale IP. Used to bind published ports to the tailnet
# interface only (never 0.0.0.0), keeping services off the home LAN.
TAILSCALE_IP=100.65.77.63

# Canonical registry address: ${TAILSCALE_IP}:30500. Own-service image refs use
# ${REGISTRY_HOST}/<name>:<tag>. Keep it in sync with TAILSCALE_IP (.env can't
# reference another var). The box's own /etc/docker/daemon.json also needs this
# value as a literal in insecure-registries (daemon.json can't read env).
REGISTRY_HOST=100.65.77.63:30500

# Base domain for public (Cloudflare) routes. Reserved: unused until a
# cloudflared ingress route exists. Set to your domain when that day comes.
BASE_DOMAIN=example.com

# Consumed by transmission (a linuxserver image) — the first service here that
# honours them; registry:2 and Home Assistant still run as root. These must match
# the ownership of TORRENT_DOWNLOADS on the box or transmission can't write.
PUID=1000
PGID=1000

# Host path behind the torrent_downloads bind-volume. It MUST already exist on
# the box — if it doesn't, transmission refuses to start (deliberately: a plain
# bind mount would instead silently create it and fill the internal SSD).
# There is no external disk today; this is on the internal NVMe (~200 G free).
# Point it at a disk's mountpoint when there is one — nothing else changes.
TORRENT_DOWNLOADS=/srv/torrents

# gluetun's SERVER_REGIONS for Windscribe. Japan = lowest latency from Korea.
# These are gluetun's region names and depend on your Windscribe plan tier; list
# the valid ones with:
#   docker run --rm qmcgaw/gluetun:v3.41.3 format-servers -windscribe
VPN_SERVER_REGIONS=Japan

# duri image tag: ${REGISTRY_HOST}/duri:${DURI_TAG}. Set to the version/SHA you
# built and pushed from a dev machine; never :latest. duri's OWN app secrets
# (Supabase service-role key, DATABASE_URL, ANTHROPIC_API_KEY) do NOT go here —
# they live in a gitignored duri.env consumed via env_file. See SPEC.md §Services.
DURI_TAG=v1
